# ==============================================================================
# VIBE DIGITAL STORE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env.local` to override local defaults.
# Note: The app includes full in-memory/localStorage mock fallbacks, so it runs
# 100% out-of-the-box even without external API credentials!
# ==============================================================================

# Supabase Configuration (Optional - for persistent cloud database & storage)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Resend Email Configuration (Optional - for real transactional email delivery)
# RESEND_API_KEY=re_123456789
# SENDER_EMAIL=onboarding@resend.dev

# Public App URL (For generating absolute download links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
